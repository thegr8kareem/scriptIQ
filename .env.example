# Supabase project credentials (Dashboard → Project Settings → API).
# Copy this file to `.env` and fill in your values — never commit `.env`.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Local backend (used when Supabase is not configured).
# Default: http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Demo mode — DEV only, no real auth.
# Set to "true" to enable a demo session without Supabase or the backend.
# NEVER set this in a production build.
VITE_ENABLE_DEMO_AUTH=false
